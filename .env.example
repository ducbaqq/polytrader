# Copy to .env (never commit .env).

# --- DigitalOcean Spaces bucket with the recorder's archive -------------------------------------
# Needed by the recorder's archive job (droplet) and by `polydata sync` (analysis machines).
# Create a key under DigitalOcean > API > Spaces Keys; read-only access is enough for analysis.
SPACES_BUCKET=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=

# --- Postgres (recorder catalog/health tables) ---------------------------------------------------
# Recorder only. Optional: without it the recorder still writes data files, just no catalog.
DATABASE_URL=
# CA certificate of the managed database (download from the DigitalOcean database page).
DATABASE_CA_CERT=

# --- Optional -------------------------------------------------------------------------------------
# Recorder: where data files are written (default ./data/recorder) and zstd level (default 9).
# RECORDER_DATA_DIR=
# RECORDER_ZSTD_LEVEL=
# RECORDER_MIN_FREE_GB=        # stop recording below this much free disk (default 3)
# Analysis: where `polydata` keeps raw/, parquet/ and polytrader.duckdb (default ./data).
# POLYDATA_DIR=
